# Lift & Lean 環境変数テンプレート
# このファイルをコピーして .env を作る。.env は絶対にcommitしない。
#   cp .env.example .env

# ============================================================
# OpenAI（既存機能：食事推定・画像解析・AI目標提案）
# ============================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# モデル指定（未設定時はコード内の既定値を使用）
# ESTIMATE_MEAL_SEARCH_MODEL=gpt-5.6-terra
# ESTIMATE_MEAL_SEARCH_FALLBACK_MODEL=gpt-4o
# SUGGEST_GOALS_MODEL=gpt-5.6-sol
# SUGGEST_GOALS_FALLBACK_MODEL=gpt-4.1

# ============================================================
# Web Push 通知（既存機能）
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron の認証用シークレット（未設定なら検証をスキップする実装）
CRON_SECRET=

# ============================================================
# Appwrite Cloud（新規：DB / Auth）
# ============================================================
# Appwrite Console > プロジェクト設定 から取得する。
# エンドポイントは Cloud なら基本この値のまま。
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=

# API key はサーバー専用。admin権限で全ての権限チェックをバイパスするため、
# フロントエンドへ出したり commit したりしない。
# 必要なscope: databases.read / databases.write / tables.read / tables.write
#              / rows.read / rows.write / users.read / users.write
APPWRITE_API_KEY=

# データベースID。npm run db:setup がこのIDで作成する（未設定なら liftandlean）
APPWRITE_DATABASE_ID=liftandlean

# フロントエンド（Vite）向け。ビルド時にバンドルへ埋め込まれるため
# 公開してよい値だけを設定すること。API key は絶対に置かない。
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# ============================================================
# MCP / OAuth（新規：ChatGPT連携）
# ============================================================
# このMCPサーバー自身の公開URL。アクセストークンの audience 検証に使う。
# 例: https://lift-and-lean.vercel.app/api/mcp
MCP_RESOURCE_URL=

# データの読み込み元を切り替える安全弁。
# local = 従来通りlocalStorageを source of truth にする（移行前・rollback時）
# db    = Appwriteを source of truth にする（移行検証が通った後）
VITE_DATA_SOURCE=local
