{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.ts"
    },
    {
      "source": "/.well-known/oauth-(.*)",
      "destination": "/api/server.ts"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/server.ts"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-morning-reminder",
      "schedule": "0 22 * * *"
    }
  ]
}
